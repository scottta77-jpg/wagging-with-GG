{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home-pages/home-v3", "destination": "/home", "permanent": true },
    { "source": "/home-pages/home-v1", "destination": "/home", "permanent": true },
    { "source": "/company-pages/about", "destination": "/about", "permanent": true },
    { "source": "/services-pages/services-v1", "destination": "/services", "permanent": true },
    { "source": "/services-pages/services-v3", "destination": "/services", "permanent": true },
    { "source": "/services-v1", "destination": "/services", "permanent": true },
    { "source": "/company-pages/contact", "destination": "/contact", "permanent": true },
    { "source": "/booking-pages/book-an-appoinment-v1", "destination": "/book-an-appoinment", "permanent": true },
    { "source": "/booking-pages/book-an-appointment-v1", "destination": "/book-an-appoinment", "permanent": true },
    { "source": "/book-an-appointment-v1", "destination": "/book-an-appoinment", "permanent": true },
    { "source": "/terms-and-conditions", "destination": "/terms", "permanent": true },
